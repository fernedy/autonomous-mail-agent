# ==========================================
# Microsoft Graph API (ÚNICO método de conexión)
# OAuth2 Client Credentials — app-only, desatendido
# ==========================================
# App registration en Azure AD con permisos de aplicación:
#   Mail.ReadWrite, Mail.Send, User.Read.All (con admin consent)
GRAPH_TENANT_ID=your-azure-tenant-id
GRAPH_CLIENT_ID=your-app-registration-client-id
GRAPH_CLIENT_SECRET=your-app-registration-secret
# Buzón a operar (obligatorio en modo app-only; /me no existe en client credentials)
GRAPH_MAILBOX_UPN=usuario@empresa.com

# ==========================================
# LLM Router Gateway (embebido)
# Integración tipo API OpenAI — detección de intención y
# selección automática de modelo
# ==========================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_GATEWAY_MODEL=gpt-4o-mini
# Modelos dedicados por intención (opcional; si se omiten usa LLM_GATEWAY_MODEL)
# LLM_GATEWAY_MODEL_TRIAGE=gpt-4o-mini
# LLM_GATEWAY_MODEL_UI=gpt-4o-mini
# LLM_GATEWAY_MODEL_PROFILE=gpt-4o
# Etiqueta del engine para telemetría
LLM_GATEWAY_ENGINE=openai

# ==========================================
# Configuración de Telegram (Notificaciones/Control)
# ==========================================
TELEGRAM_BOT_TOKEN=TOKEN
TELEGRAM_CHAT_ID=CHATID

# ==========================================
# MANEJO DE COLAS
# ==========================================
REDIS_PASS=PASS
REDIS_URL=redis://:PASS@redis:6379/0

# ==========================================
# Observabilidad y Telemetría
# ==========================================
LOKI_ENDPOINT=http://loki:3100/loki/api/v1/push
