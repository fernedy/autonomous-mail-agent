    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null } ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Time" },
            "properties": [ { "id": "custom.width", "value": 160 } ]
          },
          {
            "matcher": { "id": "byName", "options": "sender" },
            "properties": [ { "id": "custom.width", "value": 180 } ]
          },
          {
            "matcher": { "id": "byName", "options": "decision" },
            "properties": [
              { "id": "custom.width", "value": 100 },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "Action": { "color": "#FF9830", "text": "Acción" },
                      "Noise": { "color": "#73BF69", "text": "Ruido" },
                      "Executive_Decision": { "color": "#E61919", "text": "Decisión Ejecutiva" },
                      "Meeting": { "color": "#4A9EF5", "text": "Reunión" }
                    },
                    "type": "value"
                  }
                ]
              },
              { "id": "custom.cellOptions", "value": { "type": "color-text" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "reason" },
            "properties": [ { "id": "custom.width", "value": 600 } ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 23 },
      "id": 4,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [ { "desc": true, "displayName": "Time" } ]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "{job=\"jarvis-agent\"} |= \"email_evaluation\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Registro de Evaluaciones",
      "transformations": [
        {
          "id": "extractFields",
          "options": {
            "format": "json",
            "replace": true,
            "source": "Line"
          }
        },
        {
          "id": "extractFields",
          "options": {
            "format": "json",
            "replace": false,
            "source": "data"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Line": true,
              "event_type": true,
              "level": true,
              "component": true,
              "data": true,
              "message": true,
              "timestamp": true,
              "json_body": true,
              "detected_level": true,
              "service_name": true,
              "level_extracted": true,
              "worker": true,
              "model": true,
              "total_tokens": true,
              "latency_ms": true,
              "status": true,
              "labels": true,
              "tsNs": true,
              "id": true,
              "labelTypes": true,
              "action": true
            },
            "indexByName": {
              "Time": 0,
              "sender": 1,
              "decision": 2,
              "reason": 3,
              "subject": 4,
              "mail_id": 5
            },
            "renameByName": {
              "decision": "Decisión",
              "sender": "Remitente",
              "reason": "Razón",
              "subject": "Asunto",
              "mail_id": "ID Correo",
              "Time": "Hora"
            }
          }
        }
      ],
      "type": "table"
    },
