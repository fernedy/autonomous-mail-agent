    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "Porcentaje de llamadas LLM que resultaron en error sobre el total de solicitudes",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 100,
          "min": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#4AF626", "value": null },
              { "color": "#EAB839", "value": 5 },
              { "color": "#E61919", "value": 15 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 11 },
      "id": 57,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"jarvis-agent\"} | json | event_type=\"tactical\" | json action=\"data.action\", decision=\"data.decision\", sender=\"data.sender\", model=\"data.model\", total_tokens=\"data.total_tokens\", latency_ms=\"data.latency_ms\", status=\"data.status\" | action=\"infrastructure_error\" [$__range]))",
          "legendFormat": "Errores",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"jarvis-agent\"} | json | event_type=\"tactical\" | json action=\"data.action\", decision=\"data.decision\", sender=\"data.sender\", model=\"data.model\", total_tokens=\"data.total_tokens\", latency_ms=\"data.latency_ms\", status=\"data.status\" | action=\"llm_telemetry\" [$__range]))",
          "legendFormat": "Total",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "title": "Tasa de Error en API LLM",
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "alias": "Tasa de Error (%)",
            "binary": {
              "left": "Value #A",
              "operator": "/",
              "right": "Value #B"
            },
            "mode": "binaryArithmetic"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Porcentaje Final",
            "binary": {
              "left": "Tasa de Error (%)",
              "operator": "*",
              "right": "100"
            },
            "mode": "binaryArithmetic"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #A": true,
              "Value #B": true,
              "Tasa de Error (%)": true
            },
            "indexByName": {},
            "renameByName": {
              "Porcentaje Final": "Error %"
            }
          }
        }
      ],
      "type": "stat"
    },
