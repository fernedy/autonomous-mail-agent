    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "Costo total estimado basado en tokens consumidos. Tarifa estimada: $0.25 por mill\u00f3n de tokens (modelo Gemini 3.5 Flash)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#73BF69" },
          "decimals": 4,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null } ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "id": 52,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(sum_over_time({job=\"jarvis-agent\"} | json | event_type=\"tactical\" | json action=\"data.action\", decision=\"data.decision\", sender=\"data.sender\", model=\"data.model\", total_tokens=\"data.total_tokens\", latency_ms=\"data.latency_ms\", status=\"data.status\" | action=\"llm_telemetry\" | unwrap total_tokens [$__range]))",
          "legendFormat": "Total Tokens",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Costo Total Estimado (USD)",
      "transformations": [
        {
          "id": "math",
          "expression": "$A * 0.00000025"
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value": true
            },
            "indexByName": {},
            "renameByName": {
              "Expression": "Costo Estimado (USD)"
            }
          }
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "Costo promedio estimado por cada 1,000 solicitudes LLM",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#F4D03F" },
          "decimals": 6,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "yellow", "value": null } ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "id": 53,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(sum_over_time({job=\"jarvis-agent\"} | json | event_type=\"tactical\" | json action=\"data.action\", decision=\"data.decision\", sender=\"data.sender\", model=\"data.model\", total_tokens=\"data.total_tokens\", latency_ms=\"data.latency_ms\", status=\"data.status\" | action=\"llm_telemetry\" | unwrap total_tokens [$__range]))",
          "legendFormat": "Total Tokens",
          "queryType": "range",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"jarvis-agent\"} | json | event_type=\"tactical\" | json action=\"data.action\", decision=\"data.decision\", sender=\"data.sender\", model=\"data.model\", total_tokens=\"data.total_tokens\", latency_ms=\"data.latency_ms\", status=\"data.status\" | action=\"llm_telemetry\" [$__range]))",
          "legendFormat": "Total Llamadas",
          "queryType": "range",
          "refId": "B"
        }
      ],
      "title": "Costo Promedio por 1K Solicitudes (USD)",
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "alias": "Costo por 1K (USD)",
            "binary": {
              "left": "Value #A",
              "operator": "/",
              "right": "Value #B"
            },
            "mode": "binaryArithmetic"
          }
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Resultado Final",
            "binary": {
              "left": "Costo por 1K (USD)",
              "operator": "*",
              "right": "0.00025"
            },
            "mode": "binaryArithmetic"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Value #A": true,
              "Value #B": true,
              "Costo por 1K (USD)": true
            },
            "indexByName": {},
            "renameByName": {
              "Resultado Final": "Costo Promedio"
            }
          }
        }
      ],
      "type": "stat"
    },
