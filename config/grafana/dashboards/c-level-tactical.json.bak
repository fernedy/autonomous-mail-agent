    },
    {
      "datasource": { "type": "loki", "uid": "Loki" },
      "description": "Volumen total de correos electrónicos evaluados por el sistema de triage",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "#4AF626" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "green", "value": null } ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 31,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "Loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"jarvis-agent\"} | json | event_type=\"tactical\" | json action=\"data.action\", decision=\"data.decision\", sender=\"data.sender\", model=\"data.model\", total_tokens=\"data.total_tokens\", latency_ms=\"data.latency_ms\", status=\"data.status\" | action=\"email_evaluation\" [$__range]))",
          "legendFormat": "Total",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Total de Evaluaciones",
      "type": "stat"
    },
    {
