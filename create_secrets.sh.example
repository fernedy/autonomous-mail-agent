#!/bin/bash
# 🛡️ GENERADOR DE SECRETOS (PLANTILLA) — copia a create_secrets.sh y rellena valores reales
# Nunca subas create_secrets.sh (con valores reales) al repositorio.
mkdir -p ./secrets

echo -n "CAMBIA_ESTE_PASSWORD_REDIS" > ./secrets/redis_pass.txt
echo -n "TU_GRAPH_CLIENT_SECRET_AQUI" > ./secrets/graph_client_secret.txt
echo -n "TU_TELEGRAM_BOT_TOKEN_AQUI" > ./secrets/telegram_bot_token.txt
echo -n "TU_TELEGRAM_CHAT_ID_AQUI" > ./secrets/telegram_chat_id.txt
echo -n "CAMBIA_ESTE_PASSWORD_POSTGRES" > ./secrets/postgres_pass.txt

chmod 600 ./secrets/*.txt
echo "✅ Secretos generados en ./secrets/ (usa valores reales, no los subas a git)"
